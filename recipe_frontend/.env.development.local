# Ensures CRA dev server runs deterministically in non-interactive environments

# Force the dev server to use a fixed port and avoid interactive prompts
PORT=3000
HOST=0.0.0.0
BROWSER=none

# Reduce memory pressure in constrained environments
# CRA respects GENERATE_SOURCEMAP for build; for dev we also set CHOKIDAR_USEPOLLING to limit watchers
GENERATE_SOURCEMAP=false
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true

# Webpack Dev Server client overlay config via env (CRA uses overlay settings internally; we keep it minimal)
# These variables are read by react-scripts/webpack dev server for some setups and are safe to keep.
WDS_SOCKET_PORT=3000
WDS_SOCKET_PATH=/ws
