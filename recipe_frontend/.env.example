# PUBLIC_INTERFACE
# Example environment configuration for recipe_frontend (Create React App)
# Copy to .env or set via deployment environment

# Networking
PORT=3000
HOST=0.0.0.0
BROWSER=none

# Healthcheck (served from public/healthz)
REACT_APP_HEALTHCHECK_PATH=/healthz

# Backend integration (optional)
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=

# Runtime flags
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_EXPERIMENTS_ENABLED=false
REACT_APP_FEATURE_FLAGS={}

# Build/dev tuning for low-memory containers
REACT_APP_ENABLE_SOURCE_MAPS=false
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true
# Lower memory usage in Node/V8
# Note: do not set here if your env already configures NODE_OPTIONS
# NODE_OPTIONS=--max_old_space_size=256

# Logging and server
REACT_APP_LOG_LEVEL=info
REACT_APP_TRUST_PROXY=true
REACT_APP_PORT=3000
