# Example environment configuration for recipe_frontend

# PUBLIC_INTERFACE
# Port configuration
PORT=3000
REACT_APP_PORT=3000
HOST=0.0.0.0
BROWSER=none

# Healthcheck route (served by CRA static file and shim)
REACT_APP_HEALTHCHECK_PATH=/healthz

# Source maps toggle (default off to reduce memory)
REACT_APP_ENABLE_SOURCE_MAPS=false
GENERATE_SOURCEMAP=false

# Environment flags
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info

# Feature flags
REACT_APP_FEATURE_FLAGS={}
REACT_APP_EXPERIMENTS_ENABLED=false

# URLs (configure according to your backend and websocket endpoints)
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=
