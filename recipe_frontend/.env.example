# PUBLIC_INTERFACE
# Example environment variables for the recipe_frontend container.
# Copy this to .env and adjust values as needed.

# App URLs
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_BACKEND_URL=http://localhost:5000
REACT_APP_API_BASE=/api
REACT_APP_WS_URL=ws://localhost:5000

# Environment and behavior
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=false
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/healthz
REACT_APP_FEATURE_FLAGS={}
REACT_APP_EXPERIMENTS_ENABLED=false

# Port
REACT_APP_PORT=3000
